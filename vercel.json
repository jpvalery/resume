{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "astro",
	"rewrites": [
		{
			"source": "/pdf",
			"destination": "/resume.pdf"
		}
	],
	"headers": [
		{
			"source": "/(pdf|resume\\.pdf)",
			"headers": [
				{
					"key": "Content-Disposition",
					"value": "attachment; filename=\"resume.pdf\""
				}
			]
		}
	]
}
