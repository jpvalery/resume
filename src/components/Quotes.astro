---
interface Props {
	quotes: { text: string; author: string; context: string }[];
}

const { quotes } = Astro.props;
---

<div class="grid gap-4">
	{quotes.map((quote) => (
		<figure class="border-l-2 border-zinc-800 pl-3">
			<blockquote class="text-base leading-snug font-medium text-zinc-900">
				“{quote.text}”
			</blockquote>
			<figcaption class="mt-1 text-xs text-zinc-600">
				<span class="font-semibold text-zinc-800">{quote.author}</span> ·{' '}
				{quote.context}
			</figcaption>
		</figure>
	))}
</div>
